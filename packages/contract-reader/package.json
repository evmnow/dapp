{
  "name": "@evmnow/contract-reader",
  "type": "module",
  "version": "0.7.0",
  "description": "Components, composables and utilities for inspecting and interacting with verified EVM smart contracts.",
  "license": "MIT",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./components/*": "./app/components/*.vue",
    "./types/*": "./app/types/*.ts",
    "./utils/*": "./app/utils/*.ts",
    "./composables/*": "./app/composables/*.ts"
  },
  "files": [
    "app",
    "nuxt.config.ts",
    "app.config.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "nuxi dev .playground",
    "dev:prepare": "nuxt prepare .playground",
    "build": "nuxt build .playground",
    "generate": "nuxt generate .playground",
    "preview": "nuxt preview .playground",
    "typecheck": "nuxi typecheck .playground",
    "test": "vitest run"
  },
  "dependencies": {
    "@1001-digital/layers.evm": "^2.9.0",
    "@evmnow/sdk": "^0.7.0",
    "@wagmi/core": "^3.4.1",
    "shiki": "^4.3.0",
    "viem": "^2.48.4"
  },
  "peerDependencies": {
    "nuxt": "^4.4.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "nuxt": "^4.4.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.6"
  }
}
